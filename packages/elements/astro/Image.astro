---
// <medkit-image> for Astro; renders exactly what renderImage() writes. Props
// is defined in render.ts, where tsc checks it; this file is not type-checked
// until Astro's checker supports TypeScript 7.
import { renderImage, type ImageProps } from '@medkitjs/elements';

type Props = ImageProps;
const { manifest, ...options } = Astro.props;
---

<Fragment set:html={renderImage(manifest, options)} />
