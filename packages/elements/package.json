{
  "name": "@medkitjs/elements",
  "version": "0.0.0",
  "private": true,
  "description": "Accessible, dependency-free media custom elements and SSR helpers for images, background video and playback",
  "keywords": [
    "custom-elements",
    "web-components",
    "responsive-images",
    "picture",
    "srcset",
    "avif",
    "webp",
    "lazy-loading",
    "accessibility",
    "ssr",
    "cdn"
  ],
  "license": "MIT",
  "author": "koyev",
  "homepage": "https://github.com/medkitjs/medkit/tree/main/packages/elements#readme",
  "bugs": {
    "url": "https://github.com/medkitjs/medkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medkitjs/medkit.git",
    "directory": "packages/elements"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "development": "./dist/image-dev.js",
      "default": "./dist/image.js"
    },
    "./image-dev": {
      "types": "./dist/image-dev.d.ts",
      "default": "./dist/image-dev.js"
    },
    "./video-bg": {
      "types": "./dist/video-bg.d.ts",
      "default": "./dist/video-bg.js"
    },
    "./player": {
      "types": "./dist/player.d.ts",
      "development": "./dist/player-dev.js",
      "default": "./dist/player.js"
    },
    "./player-dev": {
      "types": "./dist/player-dev.d.ts",
      "default": "./dist/player-dev.js"
    },
    "./hls": {
      "types": "./dist/hls.d.ts",
      "default": "./dist/hls.js"
    },
    "./manifest.schema.json": "./dist/manifest.schema.json",
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./astro/*": "./astro/*.astro"
  },
  "files": [
    "dist",
    "astro"
  ],
  "scripts": {
    "build": "tsc -b && ts-json-schema-generator --path src/manifest.ts --type Manifest --out dist/manifest.schema.json"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.9",
    "hls.js": "^1.7.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-json-schema-generator": "^2.9.0"
  },
  "peerDependencies": {
    "astro": ">=5",
    "react": ">=19",
    "hls.js": ">=1.5"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "hls.js": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
