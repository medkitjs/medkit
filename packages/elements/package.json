{
  "name": "@medkitjs/elements",
  "version": "0.0.0",
  "description": "Accessible, dependency-free media custom elements and SSR helpers",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medkitjs/medkit.git",
    "directory": "packages/elements"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "development": "./dist/image-dev.js",
      "default": "./dist/image.js"
    },
    "./image-dev": {
      "types": "./dist/image-dev.d.ts",
      "default": "./dist/image-dev.js"
    },
    "./video-bg": {
      "types": "./dist/video-bg.d.ts",
      "default": "./dist/video-bg.js"
    },
    "./player": {
      "types": "./dist/player.d.ts",
      "default": "./dist/player.js"
    },
    "./manifest.schema.json": "./dist/manifest.schema.json",
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./astro": "./astro/Image.astro"
  },
  "files": [
    "dist",
    "astro"
  ],
  "scripts": {
    "build": "tsc -b && ts-json-schema-generator --path src/manifest.ts --type Manifest --out dist/manifest.schema.json"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-json-schema-generator": "^2.9.0"
  },
  "peerDependencies": {
    "astro": ">=5",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
