{
  "name": "@medkitjs/core",
  "version": "0.0.0",
  "private": true,
  "description": "Build-time image and video processing with sharp and ffmpeg, writing the JSON manifests medkit renders from",
  "keywords": [
    "sharp",
    "image-processing",
    "avif",
    "webp",
    "responsive-images",
    "blur-placeholder",
    "build-tool",
    "manifest"
  ],
  "license": "MIT",
  "author": "koyev",
  "homepage": "https://github.com/medkitjs/medkit/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/medkitjs/medkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medkitjs/medkit.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
