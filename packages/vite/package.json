{
  "name": "@medkitjs/vite",
  "version": "0.0.0",
  "private": true,
  "description": "Vite plugin for medkit: import media as processed manifests, cached in dev; covers Astro too",
  "keywords": [
    "vite",
    "vite-plugin",
    "astro",
    "image-processing",
    "responsive-images",
    "avif",
    "webp"
  ],
  "license": "MIT",
  "author": "koyev",
  "homepage": "https://github.com/medkitjs/medkit/tree/main/packages/vite#readme",
  "bugs": {
    "url": "https://github.com/medkitjs/medkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medkitjs/medkit.git",
    "directory": "packages/vite"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "dependencies": {
    "@medkitjs/core": "workspace:*",
    "@medkitjs/elements": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=8"
  },
  "devDependencies": {
    "vite": "^8.3.7"
  }
}
